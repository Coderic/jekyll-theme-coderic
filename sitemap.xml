---
layout: none
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% comment %}
  jekyll-polyglot: en default_lang, page.url es la ruta sin prefijo (/foo.html).
  Se emite una entrada por cada idioma en site.languages (alineado con hreflang).
  sitemap.xml esta en exclude_from_localization: solo se genera en la pasada default_lang.
{% endcomment %}
{% assign collections = site.collections | where_exp: 'collection', 'collection.output != false' %}
{% for collection in collections %}
  {% assign docs = collection.docs | where_exp: 'doc', 'doc.sitemap != false' %}
  {% for doc in docs %}
    {% assign purl = doc.url | replace: '/index.html', '/' %}
    {% for lang in site.languages %}
      {% if lang == site.default_lang %}
        {% assign _loc = purl | absolute_url %}
      {% else %}
        {% capture _loc %}{{ site.url }}{{ site.baseurl }}/{{ lang }}{{ purl }}{% endcapture %}
      {% endif %}
  <url>
    <loc>{{ _loc | xml_escape }}</loc>
      {% if doc.last_modified_at or doc.date %}
    <lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
      {% endif %}
  </url>
    {% endfor %}
  {% endfor %}
{% endfor %}

{% assign sitemap_pages = site.html_pages | where_exp: 'p', 'p.sitemap != false' | where_exp: 'p', 'p.url != "/404.html"' | where_exp: 'p', 'p.url != "/sitemap.xml"' %}
{% for page in sitemap_pages %}
  {% assign purl = page.url | replace: '/index.html', '/' %}
  {% for lang in site.languages %}
    {% if lang == site.default_lang %}
      {% assign _loc = purl | absolute_url %}
    {% else %}
      {% capture _loc %}{{ site.url }}{{ site.baseurl }}/{{ lang }}{{ purl }}{% endcapture %}
    {% endif %}
  <url>
    <loc>{{ _loc | xml_escape }}</loc>
    {% if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
  {% endfor %}
{% endfor %}

{% assign html_exts = ",.htm,.html,.xhtml,.pdf," %}
{% for file in site.static_files %}
  {% unless file.sitemap == false %}
    {% assign ext = file.extname | downcase %}
    {% if html_exts contains ext %}
      {% unless file.name == "404.html" %}
  <url>
    <loc>{{ file.path | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
    <lastmod>{{ file.modified_time | date_to_xmlschema }}</lastmod>
  </url>
      {% endunless %}
    {% endif %}
  {% endunless %}
{% endfor %}
</urlset>
